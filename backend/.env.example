# MoodAudio Studio — Backend & Audio Processing Worker Configuration
# Copy this file to .env and configure for your local or production deployment.
# Never commit real API secrets or production credentials to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PRODUCT_NAME="MoodAudio Studio"
APP_ENV="development"                  # "development" | "staging" | "production"
HOST="0.0.0.0"
PORT=8000
FRONTEND_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Railway PostgreSQL or Local SQLite)
# ------------------------------------------------------------------------------
# For local development, leave empty to automatically use local SQLite (`moodaudio_jobs.db`).
# In production on Railway, provide your PostgreSQL connection URI:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. JOB QUEUE CONFIGURATION (Optional Redis Queue)
# ------------------------------------------------------------------------------
# Defaults to asyncio in-process worker queue. Set to Redis URI if deploying distributed workers:
# REDIS_URL=redis://default:password@roundhouse.proxy.rlwy.net:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION (Local Disk or Private S3/Cloudflare R2/Railway Bucket)
# ------------------------------------------------------------------------------
# Options: "local" (default) or "s3"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 / Railway Bucket Configuration (Required if STORAGE_BACKEND=s3):
# STORAGE_BUCKET=moodaudio-media
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=your-access-key-id
# STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# STORAGE_REGION=auto
# STORAGE_PUBLIC_URL_PREFIX=https://cdn.yourdomain.com/audio

# ------------------------------------------------------------------------------
# 5. AUDIO PROCESSING, RESTRICTIONS & TIMEOUTS
# ------------------------------------------------------------------------------
# Maximum upload payload size in megabytes (enforced on multipart stream)
MAX_UPLOAD_SIZE_MB=100

# Maximum audio duration in seconds (enforced via ffprobe stream inspection)
MAX_AUDIO_DURATION_SECONDS=3600

# Maximum wall-clock processing timeout per job in seconds (prevents worker lockup)
JOB_TIMEOUT_SECONDS=600

# Retention policies for automatic cleanup of intermediate workspaces and outputs
TEMP_FILE_RETENTION_HOURS=24
OUTPUT_RETENTION_HOURS=72

# Directory for staging and local storage (defaults to backend/downloads)
# DOWNLOADS_DIR=/data/moodaudio/downloads

# ------------------------------------------------------------------------------
# 6. EXTERNAL SOURCE EXTRACTION & BOTGUARD BYPASS (yt-dlp)
# ------------------------------------------------------------------------------
# Mode: "local" (worker extracts directly) or "remote"
EXTRACTION_MODE=local

# BgUtils PO Token Provider (Node.js service for YouTube BotGuard attestation)
BGUTIL_BASE_URL=http://localhost:4416

# Optional Netscape cookies content or path if running from datacenter IP
# YTDLP_COOKIES="# Netscape HTTP Cookie File..."
# YTDLP_COOKIES_PATH=/etc/moodaudio/cookies.txt
